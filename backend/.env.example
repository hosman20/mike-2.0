PORT=3001
FRONTEND_URL=http://localhost:3000

# HMAC key used to sign /download/:token URLs. Required at startup.
# Generate with: openssl rand -hex 32
# Use a dedicated secret distinct from SUPABASE_SECRET_KEY.
DOWNLOAD_SIGNING_SECRET=replace-with-a-random-32-byte-hex-string
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-service-role-key

R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=mike

# Vercel AI Gateway — all LLM traffic routes through here so the platform
# (not the customer) pays providers. Obtain a static gateway key from
# https://vercel.com/dashboard → Settings → AI Gateway. On Vercel
# deployments you can use OIDC instead (VERCEL_OIDC_TOKEN, provisioned
# automatically by `vercel env pull`), in which case this var is optional.
AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

RESEND_API_KEY=your-resend-key

# Stripe billing — drives subscriptions, trial gating, and the paywall on
# AI chat endpoints. Get the secret key + webhook signing secret from
# https://dashboard.stripe.com → Developers. Price IDs map to the four
# tiers in the architecture doc; create the products + prices once per
# environment (test mode for dev, live mode for prod) and paste the
# `price_…` strings here. The trial tier has no Stripe price — it's the
# default state after signup, gated server-side for 14 days.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Dev-only: skip JWT verification and paywall checks. Always rejected when NODE_ENV=production.
# Set to 1 only on local machines.
DEV_AUTH_BYPASS=

